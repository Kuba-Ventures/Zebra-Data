# ============================================================================
# Zebra Data — environment configuration
# Copy to .env.local and fill in. Never commit .env.local.
# ============================================================================

# --- Supabase (required) ---------------------------------------------------
# From Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...     # SERVER-ONLY. Used by cron + admin paths.

# --- Direct Postgres connection (for Drizzle migrations) -------------------
# Supabase → Project Settings → Database → Connection string (Session pooler)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
PHI_ENCRYPTION_KEY=replace-with-a-long-random-string-min-32-chars

# --- Cron auth ------------------------------------------------------------
# Random string. Vercel Cron passes this in Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace-with-a-long-random-string

# --- Connector credentials (all optional — connectors fall back to mock) ---
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
